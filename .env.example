# Use "langfuse" in real environments. "mock" is for local UI checks only.
DATA_SOURCE=langfuse

# Local/self-hosted Langfuse only. Online Langfuse Cloud is intentionally rejected.
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Maximum traces loaded into the grouping cache per refresh.
LANGFUSE_MAX_TRACES=1000
